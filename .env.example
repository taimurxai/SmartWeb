# ==============================================================================
# SmartWeb Enterprise Configuration
# ==============================================================================

# Application Environment ('production' or 'development')
NODE_ENV="production"

# Application Port
PORT=3000

# Canonical Public URL of the Web Application
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# Database Connection (PostgreSQL recommended for production)
# For local development with SQLite: "file:./dev.db"
# For PostgreSQL: "postgresql://username:password@localhost:5432/smartweb?schema=public&connection_limit=20"
DATABASE_URL="postgresql://postgres:postgres_secure_pass_2026@localhost:5432/smartweb?schema=public"

# Cryptographic Secret for Session Signing / Verification
# Generate with: openssl rand -base64 32
JWT_SECRET="generate_a_random_secret_key_here_for_security"

# Webhook API Secret Key (Used by external software / backend triggers)
# Generate with: openssl rand -hex 24
WEBHOOK_SECRET="generate_a_secure_webhook_key_2026"

# Redis Cache & Distributed Rate Limiter (Optional for dev, recommended for production)
# Example: "redis://localhost:6379" or "rediss://default:token@cluster.upstash.io:6379"
REDIS_URL="redis://localhost:6379"
